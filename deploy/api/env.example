# /srv/lingo-api/.env on the server (root-owned, mode 600). Never commit the real one.
# Read by docker compose for the file's ${...} values and passed to the container.

# The Docker network the reverse proxy is on.
PROXY_NETWORK=
LOG_LEVEL=info

# The app's address, for passkeys and the request origin check.
ORIGINS=https://lingo.example.com
# RP_ID defaults to the host of the first origin.
# RP_ID=lingo.example.com

# Accounts with these emails get the admin role (comma separated).
ADMIN_EMAILS=

# Mail. Without MAILER=smtp nothing is sent (codes are only logged as sent).
MAILER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Envelope sender for bounces, e.g. a +bounces address of MAIL_FROM.
MAIL_BOUNCE=

# On-demand speech (optional): the Kokoro TTS service on the same Docker
# network and its API key. Without TTS_URL only recorded clips are used.
TTS_URL=
TTS_API_KEY=
# New clips a day for every signed-in learner, and for verified learners.
TTS_DAILY_LIMIT=10
TTS_VERIFIED_LIMIT=200
# Disk cache of generated speech (in /data/tts-cache), in megabytes.
TTS_CACHE_MB=2048

# Reminders by web push (optional). Make the pair once on the server with
# `npx web-push generate-vapid-keys`; without them reminders are off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can use if something goes wrong.
VAPID_SUBJECT=mailto:lingo@bololoo.com
