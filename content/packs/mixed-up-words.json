{
  "id": "mixed-up-words",
  "title": {
    "en": "Words that get mixed up",
    "fi": "Helposti sekoittuvat sanat"
  },
  "items": [
    {"id":"borrow-lend","type":"confusable","title":{"en":"borrow or lend","fi":"lainata: borrow vai lend"},"explanation":{"en":"Borrow: you get something for a while (borrow from someone). Lend: you give something for a while (lend to someone).","fi":"Suomen lainata on englanniksi kaksi eri verbiä. borrow = lainata joltakulta (saat itse). lend = lainata jollekulle (annat toiselle). Can I borrow your pen? = Voinko lainata kynääsi? Can you lend me your pen? = Voitko lainata minulle kynääsi?"},"level":1,"words":[{"text":"borrow"},{"text":"lend"}]},
    {"id":"borrow-lend-1","type":"gap","lang":"en","sentence":"Can I ___ your umbrella?","answers":["borrow"],"distractors":["lend"],"translation":{"fi":"Voinko lainata sateenvarjoasi?"},"topic":"borrow-lend","categories":[],"level":1},
    {"id":"borrow-lend-2","type":"gap","lang":"en","sentence":"Could you ___ me ten euros?","answers":["lend"],"distractors":["borrow"],"translation":{"fi":"Voisitko lainata minulle kymmenen euroa?"},"topic":"borrow-lend","categories":[],"level":1},
    {"id":"borrow-lend-3","type":"gap","lang":"en","sentence":"I ___ this book from the library.","answers":["borrowed"],"distractors":["lent"],"translation":{"fi":"Lainasin tämän kirjan kirjastosta."},"topic":"borrow-lend","categories":[],"level":1},
    {"id":"borrow-lend-4","type":"gap","lang":"en","sentence":"My neighbour ___ me his ladder.","answers":["lent"],"distractors":["borrowed"],"translation":{"fi":"Naapurini lainasi minulle tikkaansa."},"topic":"borrow-lend","categories":[],"level":1},
    {"id":"borrow-lend-5","type":"gap","lang":"en","sentence":"You can ___ my car tomorrow.","answers":["borrow"],"distractors":["lend"],"translation":{"fi":"Voit lainata autoani huomenna."},"topic":"borrow-lend","categories":[],"level":1},
    {"id":"make-do","type":"confusable","title":{"en":"make or do","fi":"tehdä: make vai do"},"explanation":{"en":"Do is for tasks, work and activities (do the dishes, do homework, do yoga). Make is for creating or producing something (make dinner, make a plan, make a mistake).","fi":"Suomen tehdä on englanniksi joko do tai make. do = tehtävät, työt ja harrastukset (do the dishes, do homework, do yoga). make = jonkin valmistaminen tai aikaansaaminen (make dinner, make a mistake, make a decision). Monet kannattaa opetella valmiina fraaseina."},"level":1,"words":[{"text":"make"},{"text":"do"}]},
    {"id":"make-do-1","type":"gap","lang":"en","sentence":"I'll ___ dinner tonight.","answers":["make"],"distractors":["do"],"translation":{"fi":"Minä teen illallisen tänään."},"topic":"make-do","categories":[],"level":1},
    {"id":"make-do-2","type":"gap","lang":"en","sentence":"Have you ___ your homework?","answers":["done"],"distractors":["made"],"translation":{"fi":"Oletko tehnyt läksysi?"},"topic":"make-do","categories":[],"level":1},
    {"id":"make-do-3","type":"gap","lang":"en","sentence":"Everyone ___ mistakes.","answers":["makes"],"distractors":["does"],"translation":{"fi":"Kaikki tekevät virheitä."},"topic":"make-do","categories":[],"level":1},
    {"id":"make-do-4","type":"gap","lang":"en","sentence":"Can you ___ the dishes?","answers":["do"],"distractors":["make"],"translation":{"fi":"Voitko tiskata?"},"explanation":{"en":"Washing up is a task, so it's do the dishes.","fi":"Tiskaaminen on kotityö, joten do the dishes."},"topic":"make-do","categories":[],"level":1},
    {"id":"make-do-5","type":"gap","lang":"en","sentence":"We need to ___ a decision.","answers":["make"],"distractors":["do"],"translation":{"fi":"Meidän pitää tehdä päätös."},"topic":"make-do","categories":[],"level":1},
    {"id":"make-do-6","type":"gap","lang":"en","sentence":"I ___ yoga twice a week.","answers":["do"],"distractors":["make"],"translation":{"fi":"Joogaan kaksi kertaa viikossa."},"topic":"make-do","categories":[],"level":1},
    {"id":"say-tell","type":"confusable","title":{"en":"say or tell","fi":"say vai tell"},"explanation":{"en":"Tell has a person right after it: tell me, tell your boss. Say does not: say hello, say something. To add a person to say, use to: say it to me.","fi":"Molemmat voivat olla suomeksi sanoa tai kertoa. tell + ihminen: tell me, tell her (kerro minulle). say + asia, ilman ihmistä: say hello, say yes. Jos say-verbin kanssa haluaa ihmisen, tarvitaan to: say it to me."},"level":1,"words":[{"text":"say"},{"text":"tell"}]},
    {"id":"say-tell-1","type":"gap","lang":"en","sentence":"Can you ___ me the way to the station?","answers":["tell"],"distractors":["say"],"translation":{"fi":"Voitko neuvoa minulle tien asemalle?"},"topic":"say-tell","categories":[],"level":1},
    {"id":"say-tell-2","type":"gap","lang":"en","sentence":"She ___ hello to everyone.","answers":["said"],"distractors":["told"],"translation":{"fi":"Hän sanoi kaikille hei."},"topic":"say-tell","categories":[],"level":1},
    {"id":"say-tell-3","type":"gap","lang":"en","sentence":"He ___ me a funny story.","answers":["told"],"distractors":["said"],"translation":{"fi":"Hän kertoi minulle hauskan tarinan."},"topic":"say-tell","categories":[],"level":1},
    {"id":"say-tell-4","type":"gap","lang":"en","sentence":"What did you ___?","answers":["say"],"distractors":["tell"],"translation":{"fi":"Mitä sanoit?"},"topic":"say-tell","categories":[],"level":1},
    {"id":"say-tell-5","type":"gap","lang":"en","sentence":"Don't ___ anyone!","answers":["tell"],"distractors":["say"],"translation":{"fi":"Älä kerro kenellekään!"},"topic":"say-tell","categories":[],"level":1},
    {"id":"say-tell-6","type":"gap","lang":"en","sentence":"I ___ yes.","answers":["said"],"distractors":["told"],"translation":{"fi":"Sanoin kyllä."},"topic":"say-tell","categories":[],"level":1},
    {"id":"long-tall","type":"confusable","title":{"en":"long or tall","fi":"pitkä: long vai tall"},"explanation":{"en":"Tall is for people, trees and buildings standing up. Long is for length from end to end, or time: a long road, long hair, a long day.","fi":"Suomen pitkä on englanniksi kaksi sanaa. tall = pitkä ylöspäin: ihmiset, puut, rakennukset (a tall man). long = pitkä päästä päähän tai ajallisesti: a long road, long hair, a long meeting."},"level":1,"words":[{"text":"long"},{"text":"tall"}]},
    {"id":"long-tall-1","type":"gap","lang":"en","sentence":"My son is very ___ for his age.","answers":["tall"],"distractors":["long"],"translation":{"fi":"Poikani on ikäisekseen tosi pitkä."},"topic":"long-tall","categories":[],"level":1},
    {"id":"long-tall-2","type":"gap","lang":"en","sentence":"It was a ___ meeting.","answers":["long"],"distractors":["tall"],"translation":{"fi":"Se oli pitkä kokous."},"topic":"long-tall","categories":[],"level":1},
    {"id":"long-tall-3","type":"gap","lang":"en","sentence":"She has ___ hair.","answers":["long"],"distractors":["tall"],"translation":{"fi":"Hänellä on pitkät hiukset."},"topic":"long-tall","categories":[],"level":1},
    {"id":"long-tall-4","type":"gap","lang":"en","sentence":"There are ___ pine trees behind our house.","answers":["tall"],"distractors":["long"],"translation":{"fi":"Talomme takana on korkeita mäntyjä."},"topic":"long-tall","categories":[],"level":1},
    {"id":"long-tall-5","type":"gap","lang":"en","sentence":"How ___ is the bridge?","answers":["long"],"distractors":["tall"],"translation":{"fi":"Kuinka pitkä silta on?"},"topic":"long-tall","categories":[],"level":1},
    {"id":"long-tall-6","type":"gap","lang":"en","sentence":"How ___ are you? I'm 180 cm.","answers":["tall"],"distractors":["long"],"translation":{"fi":"Kuinka pitkä olet? Olen 180 cm."},"topic":"long-tall","categories":[],"level":1},
    {"id":"learn-teach","type":"confusable","title":{"en":"learn or teach","fi":"learn vai teach"},"explanation":{"en":"Learn is what the student does. Teach is what the teacher does: she teaches me English, and I learn English.","fi":"learn = oppia, opiskella (sinä itse). teach = opettaa (toiselle). Ei siis \"learn me\", vaan teach me = opeta minua."},"level":1,"words":[{"text":"learn"},{"text":"teach"}]},
    {"id":"learn-teach-1","type":"gap","lang":"en","sentence":"Can you ___ me to swim?","answers":["teach"],"distractors":["learn"],"translation":{"fi":"Voitko opettaa minut uimaan?"},"topic":"learn-teach","categories":[],"level":1},
    {"id":"learn-teach-2","type":"gap","lang":"en","sentence":"I want to ___ English.","answers":["learn"],"distractors":["teach"],"translation":{"fi":"Haluan oppia englantia."},"topic":"learn-teach","categories":[],"level":1},
    {"id":"learn-teach-3","type":"gap","lang":"en","sentence":"My grandfather ___ me how to fish.","answers":["taught"],"distractors":["learned"],"translation":{"fi":"Isoisäni opetti minut kalastamaan."},"topic":"learn-teach","categories":[],"level":1},
    {"id":"learn-teach-4","type":"gap","lang":"en","sentence":"Children ___ fast.","answers":["learn"],"distractors":["teach"],"translation":{"fi":"Lapset oppivat nopeasti."},"topic":"learn-teach","categories":[],"level":1},
    {"id":"learn-teach-5","type":"gap","lang":"en","sentence":"She ___ maths at a school in Lahti.","answers":["teaches"],"distractors":["learns"],"translation":{"fi":"Hän opettaa matematiikkaa koulussa Lahdessa."},"topic":"learn-teach","categories":[],"level":1},
    {"id":"remember-remind","type":"confusable","title":{"en":"remember or remind","fi":"remember vai remind"},"explanation":{"en":"Remember: you keep something in your own mind. Remind: you help another person remember (remind me to call).","fi":"remember = muistaa (itse). remind = muistuttaa (toista). Remind me to call Mum = Muistuta minua soittamaan äidille."},"level":1,"words":[{"text":"remember"},{"text":"remind"}]},
    {"id":"remember-remind-1","type":"gap","lang":"en","sentence":"Please ___ me to buy milk.","answers":["remind"],"distractors":["remember"],"translation":{"fi":"Muistuta minua ostamaan maitoa."},"topic":"remember-remind","categories":[],"level":1},
    {"id":"remember-remind-2","type":"gap","lang":"en","sentence":"Do you ___ my name?","answers":["remember"],"distractors":["remind"],"translation":{"fi":"Muistatko nimeni?"},"topic":"remember-remind","categories":[],"level":1},
    {"id":"remember-remind-3","type":"gap","lang":"en","sentence":"This song ___ me of summer.","answers":["reminds"],"distractors":["remembers"],"translation":{"fi":"Tämä laulu muistuttaa minua kesästä."},"topic":"remember-remind","categories":[],"level":1},
    {"id":"remember-remind-4","type":"gap","lang":"en","sentence":"I can't ___ where I parked.","answers":["remember"],"distractors":["remind"],"translation":{"fi":"En muista, mihin pysäköin."},"topic":"remember-remind","categories":[],"level":1},
    {"id":"remember-remind-5","type":"gap","lang":"en","sentence":"___ to lock the door!","answers":["Remember"],"distractors":["Remind"],"translation":{"fi":"Muista lukita ovi!"},"topic":"remember-remind","categories":[],"level":1},
    {"id":"bring-take","type":"confusable","title":{"en":"bring or take","fi":"bring vai take"},"explanation":{"en":"Bring: towards the place where you (or the listener) are. Take: away to another place.","fi":"bring = tuoda (tänne, puhujan luo). take = viedä (sinne, pois täältä). Suomessa nämä ovat eri sanat, mutta englanniksi ne menevät helposti sekaisin."},"level":1,"words":[{"text":"bring"},{"text":"take"}]},
    {"id":"bring-take-1","type":"gap","lang":"en","sentence":"Can you ___ me a glass of water?","answers":["bring"],"distractors":["take"],"translation":{"fi":"Voitko tuoda minulle lasin vettä?"},"topic":"bring-take","categories":[],"level":1},
    {"id":"bring-take-2","type":"gap","lang":"en","sentence":"Don't forget to ___ your passport to the airport.","answers":["take"],"distractors":["bring"],"translation":{"fi":"Muista viedä passi mukanasi lentokentälle."},"topic":"bring-take","categories":[],"level":1},
    {"id":"bring-take-3","type":"gap","lang":"en","sentence":"I'll ___ the kids to school.","answers":["take"],"distractors":["bring"],"translation":{"fi":"Vien lapset kouluun."},"topic":"bring-take","categories":[],"level":1},
    {"id":"bring-take-4","type":"gap","lang":"en","sentence":"___ a friend to the party tonight!","answers":["Bring"],"distractors":["Take"],"translation":{"fi":"Tuo kaveri mukanasi juhliin tänä iltana!"},"topic":"bring-take","categories":[],"level":1},
    {"id":"bring-take-5","type":"gap","lang":"en","sentence":"Please ___ the rubbish out.","answers":["take"],"distractors":["bring"],"translation":{"fi":"Vie roskat ulos."},"topic":"bring-take","categories":[],"level":1},
    {"id":"hear-listen","type":"confusable","title":{"en":"hear or listen","fi":"hear vai listen"},"explanation":{"en":"Hear: a sound reaches you without trying. Listen: you pay attention on purpose. Note: listen to something (listen to music).","fi":"hear = kuulla (ääni vain tulee korviin). listen = kuunnella (keskityt tarkoituksella). Huomaa to: listen to music = kuunnella musiikkia."},"level":1,"words":[{"text":"hear"},{"text":"listen"}]},
    {"id":"hear-listen-1","type":"gap","lang":"en","sentence":"I ___ to the radio in the car.","answers":["listen"],"distractors":["hear"],"translation":{"fi":"Kuuntelen radiota autossa."},"topic":"hear-listen","categories":[],"level":1},
    {"id":"hear-listen-2","type":"gap","lang":"en","sentence":"Can you ___ me?","answers":["hear"],"distractors":["listen"],"translation":{"fi":"Kuuletko minua?"},"topic":"hear-listen","categories":[],"level":1},
    {"id":"hear-listen-3","type":"gap","lang":"en","sentence":"I ___ a strange noise last night.","answers":["heard"],"distractors":["listened"],"translation":{"fi":"Kuulin oudon äänen eilen illalla."},"topic":"hear-listen","categories":[],"level":1},
    {"id":"hear-listen-4","type":"gap","lang":"en","sentence":"___ carefully, please.","answers":["Listen"],"distractors":["Hear"],"translation":{"fi":"Kuunnelkaa tarkasti."},"topic":"hear-listen","categories":[],"level":1},
    {"id":"hear-listen-5","type":"gap","lang":"en","sentence":"Sorry, I didn't ___ what you said.","answers":["hear"],"distractors":["listen"],"translation":{"fi":"Anteeksi, en kuullut, mitä sanoit."},"topic":"hear-listen","categories":[],"level":1},
    {"id":"see-watch-look","type":"confusable","title":{"en":"see, watch or look at","fi":"see, watch vai look at"},"explanation":{"en":"See: something comes into your eyes. Watch: you follow something that moves or changes, like TV or a game. Look at: you turn your eyes to something on purpose.","fi":"see = nähdä. watch = katsella, seurata jotain liikkuvaa (TV, ottelu). look at = katsoa jotain tarkoituksella (look at this photo = katso tätä kuvaa)."},"level":1,"words":[{"text":"see"},{"text":"watch"},{"text":"look at"}]},
    {"id":"see-watch-look-1","type":"gap","lang":"en","sentence":"Did you ___ the hockey game last night?","answers":["watch"],"distractors":["see","look at"],"translation":{"fi":"Katsoitko jääkiekko-ottelun eilen illalla?"},"topic":"see-watch-look","categories":[],"level":1},
    {"id":"see-watch-look-2","type":"gap","lang":"en","sentence":"___ this photo!","answers":["Look at"],"distractors":["See","Watch"],"translation":{"fi":"Katso tätä kuvaa!"},"topic":"see-watch-look","categories":[],"level":1},
    {"id":"see-watch-look-3","type":"gap","lang":"en","sentence":"I can't ___ without my glasses.","answers":["see"],"distractors":["watch","look at"],"translation":{"fi":"En näe ilman silmälasejani."},"topic":"see-watch-look","categories":[],"level":1},
    {"id":"see-watch-look-4","type":"gap","lang":"en","sentence":"I ___ a moose on the road this morning.","answers":["saw"],"distractors":["watched","looked at"],"translation":{"fi":"Näin aamulla hirven tiellä."},"topic":"see-watch-look","categories":[],"level":1},
    {"id":"see-watch-look-5","type":"gap","lang":"en","sentence":"The children are ___ cartoons.","answers":["watching"],"distractors":["seeing","looking at"],"translation":{"fi":"Lapset katsovat piirrettyjä."},"topic":"see-watch-look","categories":[],"level":1},
    {"id":"than-then","type":"confusable","title":{"en":"than or then","fi":"than vai then"},"explanation":{"en":"Than is for comparing (bigger than). Then is about time (first this, then that) or means \"in that case\".","fi":"than = kuin vertailussa (bigger than = isompi kuin). then = sitten, silloin. Sanat kuulostavat melkein samalta, siksi ne sekoittuvat helposti kirjoittaessa."},"level":1,"words":[{"text":"than"},{"text":"then"}]},
    {"id":"than-then-1","type":"gap","lang":"en","sentence":"My car is older ___ yours.","answers":["than"],"distractors":["then"],"translation":{"fi":"Autoni on vanhempi kuin sinun."},"topic":"than-then","categories":[],"level":1},
    {"id":"than-then-2","type":"gap","lang":"en","sentence":"First we eat, ___ we go to the sauna.","answers":["then"],"distractors":["than"],"translation":{"fi":"Ensin syödään, sitten mennään saunaan."},"topic":"than-then","categories":[],"level":1},
    {"id":"than-then-3","type":"gap","lang":"en","sentence":"Helsinki is bigger ___ Turku.","answers":["than"],"distractors":["then"],"translation":{"fi":"Helsinki on isompi kuin Turku."},"topic":"than-then","categories":[],"level":1},
    {"id":"than-then-4","type":"gap","lang":"en","sentence":"I lived in Spain back ___.","answers":["then"],"distractors":["than"],"translation":{"fi":"Asuin silloin Espanjassa."},"topic":"than-then","categories":[],"level":1},
    {"id":"than-then-5","type":"gap","lang":"en","sentence":"She runs faster ___ me.","answers":["than"],"distractors":["then"],"translation":{"fi":"Hän juoksee nopeammin kuin minä."},"topic":"than-then","categories":[],"level":1},
    {"id":"its-its","type":"confusable","title":{"en":"its or it's","fi":"its vai it's"},"explanation":{"en":"It's is short for it is or it has. Its means \"belonging to it\", like his or her, and has no apostrophe.","fi":"it's = it is tai it has (se on). its = sen (omistus), aivan kuten his ja her, eikä siinä ole heittomerkkiä. Testi: jos voit sanoa it is, kirjoita it's."},"level":1,"words":[{"text":"its"},{"text":"it's"}]},
    {"id":"its-its-1","type":"gap","lang":"en","sentence":"___ cold today.","answers":["It's"],"distractors":["Its"],"translation":{"fi":"Tänään on kylmä."},"topic":"its-its","categories":[],"level":1},
    {"id":"its-its-2","type":"gap","lang":"en","sentence":"The dog wagged ___ tail.","answers":["its"],"distractors":["it's"],"translation":{"fi":"Koira heilutti häntäänsä."},"topic":"its-its","categories":[],"level":1},
    {"id":"its-its-3","type":"gap","lang":"en","sentence":"I think ___ going to rain.","answers":["it's"],"distractors":["its"],"translation":{"fi":"Luulen, että alkaa sataa."},"topic":"its-its","categories":[],"level":1},
    {"id":"its-its-4","type":"gap","lang":"en","sentence":"The company changed ___ name.","answers":["its"],"distractors":["it's"],"translation":{"fi":"Yritys vaihtoi nimensä."},"topic":"its-its","categories":[],"level":1},
    {"id":"its-its-5","type":"gap","lang":"en","sentence":"___ been a long day.","answers":["It's"],"distractors":["Its"],"translation":{"fi":"On ollut pitkä päivä."},"topic":"its-its","categories":[],"level":1},
    {"id":"fun-funny","type":"confusable","title":{"en":"fun or funny","fi":"hauska: fun vai funny"},"explanation":{"en":"Fun: you enjoy doing it (a fun evening). Funny: it makes you laugh (a funny joke). Funny can also mean strange.","fi":"Suomen hauska on englanniksi kaksi sanaa. fun = mukava, kiva tehdä (the party was fun). funny = naurattava (a funny joke). Funny voi tarkoittaa myös outoa."},"level":1,"words":[{"text":"fun"},{"text":"funny"}]},
    {"id":"fun-funny-1","type":"gap","lang":"en","sentence":"The party was really ___.","answers":["fun"],"distractors":["funny"],"translation":{"fi":"Juhlat olivat tosi hauskat."},"topic":"fun-funny","categories":[],"level":1},
    {"id":"fun-funny-2","type":"gap","lang":"en","sentence":"He told a ___ joke.","answers":["funny"],"distractors":["fun"],"translation":{"fi":"Hän kertoi hauskan vitsin."},"topic":"fun-funny","categories":[],"level":1},
    {"id":"fun-funny-3","type":"gap","lang":"en","sentence":"Skiing is ___.","answers":["fun"],"distractors":["funny"],"translation":{"fi":"Hiihtäminen on kivaa."},"topic":"fun-funny","categories":[],"level":1},
    {"id":"fun-funny-4","type":"gap","lang":"en","sentence":"That smell is ___. Is something burning?","answers":["funny"],"distractors":["fun"],"translation":{"fi":"Tuo haju on outo. Palaako jokin?"},"topic":"fun-funny","categories":[],"level":1},
    {"id":"fun-funny-5","type":"gap","lang":"en","sentence":"Have ___ at the concert!","answers":["fun"],"distractors":["funny"],"translation":{"fi":"Pidä hauskaa konsertissa!"},"topic":"fun-funny","categories":[],"level":1},
    {"id":"lose-loose","type":"confusable","title":{"en":"lose or loose","fi":"lose vai loose"},"explanation":{"en":"Lose (one o) is a verb: lose your keys, lose a game. Loose (two o's) means not tight.","fi":"lose = hukata, kadottaa, hävitä (lose your keys, lose a game). loose = löysä (loose trousers). Ääntämisessäkin on ero: lose loppuu soinnilliseen z-äänteeseen, loose s-äänteeseen."},"level":1,"words":[{"text":"lose"},{"text":"loose"}]},
    {"id":"lose-loose-1","type":"gap","lang":"en","sentence":"Don't ___ your ticket.","answers":["lose"],"distractors":["loose"],"translation":{"fi":"Älä hukkaa lippuasi."},"topic":"lose-loose","categories":[],"level":1},
    {"id":"lose-loose-2","type":"gap","lang":"en","sentence":"These jeans are too ___.","answers":["loose"],"distractors":["lose"],"translation":{"fi":"Nämä farkut ovat liian löysät."},"topic":"lose-loose","categories":[],"level":1},
    {"id":"lose-loose-3","type":"gap","lang":"en","sentence":"We always ___ against Sweden.","answers":["lose"],"distractors":["loose"],"translation":{"fi":"Häviämme aina Ruotsille."},"topic":"lose-loose","categories":[],"level":1},
    {"id":"lose-loose-4","type":"gap","lang":"en","sentence":"One of my teeth is ___.","answers":["loose"],"distractors":["lose"],"translation":{"fi":"Yksi hampaistani heiluu."},"topic":"lose-loose","categories":[],"level":1},
    {"id":"nice-sympathetic","type":"confusable","title":{"en":"nice or sympathetic","fi":"sympaattinen: nice vai sympathetic"},"explanation":{"en":"Sympathetic means you understand and feel for someone's troubles. It does not mean \"nice\". A person or place you like is nice, kind or friendly.","fi":"Harhaanjohtava sana: sympaattinen ei ole englanniksi sympathetic. sympathetic = myötätuntoinen, ymmärtäväinen. Mukava, sympaattinen ihminen tai paikka on englanniksi nice, kind tai friendly."},"level":1,"words":[{"text":"nice"},{"text":"sympathetic"}]},
    {"id":"nice-sympathetic-1","type":"gap","lang":"en","sentence":"Our new neighbour is very ___. She always says hello.","answers":["nice"],"distractors":["sympathetic"],"translation":{"fi":"Uusi naapurimme on tosi mukava. Hän tervehtii aina."},"topic":"nice-sympathetic","categories":[],"level":1},
    {"id":"nice-sympathetic-2","type":"gap","lang":"en","sentence":"The nurse was ___ when I told her about my pain.","answers":["sympathetic"],"distractors":["nice"],"translation":{"fi":"Hoitaja oli myötätuntoinen, kun kerroin kivuistani."},"topic":"nice-sympathetic","categories":[],"level":1},
    {"id":"nice-sympathetic-3","type":"gap","lang":"en","sentence":"What a ___ little café!","answers":["nice"],"distractors":["sympathetic"],"translation":{"fi":"Onpa sympaattinen pikku kahvila!"},"topic":"nice-sympathetic","categories":[],"level":1},
    {"id":"nice-sympathetic-4","type":"gap","lang":"en","sentence":"My boss was ___ when my father was ill.","answers":["sympathetic"],"distractors":["nice"],"translation":{"fi":"Pomoni oli ymmärtäväinen, kun isäni oli sairaana."},"topic":"nice-sympathetic","categories":[],"level":1},
    {"id":"current-actual","type":"confusable","title":{"en":"current or actual","fi":"aktuaalinen: current vai actual"},"explanation":{"en":"Actual means real or exact, not \"happening now\". For something happening now, say current or latest.","fi":"Harhaanjohtava sana: aktuaalinen tai ajankohtainen on englanniksi current tai latest, ei actual. actual = todellinen, varsinainen. Samoin actually = itse asiassa, ei \"nykyään\"."},"level":1,"words":[{"text":"current"},{"text":"actual"}]},
    {"id":"current-actual-1","type":"gap","lang":"en","sentence":"Let's talk about ___ events.","answers":["current"],"distractors":["actual"],"translation":{"fi":"Puhutaan ajankohtaisista asioista."},"topic":"current-actual","categories":[],"level":1},
